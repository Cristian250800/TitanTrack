<?xml version="1.0" encoding="utf-8"?>
    <android.widget.ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <TextView
    android:id="@+id/titulo_login"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/titulo_login"
    android:textSize="28sp"
    android:textStyle="bold"
    android:textColor="@color/verde_principal"
    android:layout_marginTop="48dp"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

    <EditText
    android:id="@+id/correo_login"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:hint="@string/pista_correo"
    android:textColorHint="@color/gris_medio"
    android:textColor="@color/negro"
    android:inputType="textEmailAddress"
    android:minHeight="48dp"
    android:layout_marginTop="40dp"
    app:layout_constraintTop_toBottomOf="@id/titulo_login"

    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

    <EditText
    android:id="@+id/contrasena_login"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:hint="@string/pista_contrasena"
    android:textColorHint="@color/gris_medio"
    android:textColor="@color/negro"
    android:inputType="textPassword"
    android:minHeight="48dp"
    android:layout_marginTop="16dp"
    app:layout_constraintTop_toBottomOf="@id/correo_login"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/olvidaste_contrasena"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="8dp"
        android:text="@string/enlace_olvidaste_contrasena"
        android:textColor="@color/azul"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contrasena_login" />

    <Button
    android:id="@+id/boton_login"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:text="@string/boton_login"
    android:backgroundTint="@color/verde_principal"
    android:textColor="@color/blanco"
    android:layout_marginTop="24dp"
    app:layout_constraintTop_toBottomOf="@id/olvidaste_contrasena"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

    <TextView
    android:id="@+id/ir_a_registro"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/enlace_registro"
    android:textColor="@color/verde_principal"
    android:textSize="14sp"
    android:textStyle="bold"
    android:padding="12dp"
    android:layout_marginBottom="24dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    </android.widget.ScrollView>