<?xml version="1.0" encoding="utf-8"?>
<android.widget.ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">


    <TextView
    android:id="@+id/titulo_registro"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/titulo_registro"
    android:textSize="28sp"
    android:textStyle="bold"
    android:textColor="@color/verde_principal"
    android:layout_marginTop="32dp"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

    <EditText
    android:id="@+id/nombre_registro"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:hint="@string/casilla_nombre"
    android:inputType="textPersonName"
    android:minHeight="48dp"
    android:layout_marginTop="24dp"
    app:layout_constraintTop_toBottomOf="@id/titulo_registro"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

    <EditText
    android:id="@+id/correo_registro"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:hint="@string/pista_correo"
    android:inputType="textEmailAddress"
    android:minHeight="48dp"
    android:layout_marginTop="16dp"
    app:layout_constraintTop_toBottomOf="@id/nombre_registro"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

    <EditText
    android:id="@+id/contrasena_registro"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:hint="@string/pista_contrasena"
    android:inputType="textPassword"
    android:minHeight="48dp"
    android:layout_marginTop="16dp"
    app:layout_constraintTop_toBottomOf="@id/correo_registro"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

    <EditText
    android:id="@+id/casilla_confirmar_contrasena"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:hint="@string/casilla_confirmar_contrasena"
    android:inputType="textPassword"
    android:minHeight="48dp"
    android:layout_marginTop="16dp"
    app:layout_constraintTop_toBottomOf="@id/contrasena_registro"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

    <Button
    android:id="@+id/boton_registro"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:text="@string/boton_registro"
    android:backgroundTint="@color/verde_principal"
    android:textColor="@color/blanco"
    android:layout_marginTop="24dp"
    app:layout_constraintTop_toBottomOf="@id/casilla_confirmar_contrasena"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

    <TextView
    android:id="@+id/ir_a_login"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/enlace_login"
    android:textColor="@color/verde_principal"
    android:textSize="14sp"
    android:textStyle="bold"
    android:padding="12dp"
    android:layout_marginBottom="24dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    </android.widget.ScrollView>